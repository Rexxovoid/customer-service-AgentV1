# 复制为 .env 后填写。仅保留主要服务配置，其余使用代码默认值。
# 不提交真实密钥；完整配置说明见README及Settings.load()。

# ── DeepSeek：对话及规则选择共用模型配置 ──
DEEP_BASE_URL=https://api.deepseek.com
DEEP_API_KEY=
# 按服务实际支持的模型名称填写；兼容旧变量DEEP-SEEK，DEEP_MODEL优先。
DEEP_MODEL=deepseek-chat

# ── RAGFlow：URL留空使用本地知识；启用远程后异常不静默回退 ──
RAGFLOW_API_URL=
RAGFLOW_API_KEY=
# 按远端实际名称修改；助手须绑定目标知识库，名称须唯一匹配。
RAGFLOW_DATASET_NAME=售后规则知识库
RAGFLOW_ASSISTANT_NAME=售后助手

# ── 独立千问裁判：仅测评 --judge 时需要密钥，变量拼写沿用项目 ──
QIWEN_API_KEY=
QIWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QIANWEN=qwen3.8-flash

# ── Langfuse：仅填写密钥不会启用上传 ──
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# 须与项目所在区域一致。
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 正文上传独立开关；还须 controlled_agent + 案例approved + content_upload_approved=true。
LANGFUSE_CONTENT_ENABLED=false
